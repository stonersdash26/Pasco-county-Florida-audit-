from datetime import datetime
import json
import re
import csv
from bs4 import BeautifulSoup
from playwright.sync_api import sync_playwright, TimeoutError as PlaywrightTimeoutError


class OdysseyDocketBlackholeAuditor:
    """Forensic Web Audit Engine using Playwright and BeautifulSoup to parse live public court dockets 
    (Indiana Odyssey / MyCase), detect administrative 'blackholes' (sealed dockets, missing filings, 
    improper exclusions), and extract Chronological Case Summary (CCS) data for State v. Joshua Ryan Boone.
    """

    def __init__(
        self,
        cause_no="77D01-2609-CM-000645",
        agency_ref="77A09040526",
        prosecutor_no="77-DM4020153",
    ):
        self.cause_no = cause_no
        self.agency_ref = agency_ref
        self.prosecutor_no = prosecutor_no
        self.docket_entries = []
        self.blackhole_alerts = []

    def fetch_live_docket_html(self, headless=True, timeout=30000):
        """Launches a headless browser session, navigates to the Indiana MyCase portal,
        inputs the target cause number, handles dynamic JavaScript rendering, and captures the CCS HTML.
        """
        mycase_url = "https://mycase.in.gov/"
        print(f"[*] Initializing Playwright session targeting Indiana MyCase: {mycase_url}")
        
        html_content = ""
        try:
            with sync_playwright() as p:
                browser = p.chromium.launch(headless=headless)
                context = browser.new_context(
                    user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
                    viewport={"width": 1280, "height": 800}
                )
                page = context.new_page()
                
                page.goto(mycase_url, timeout=timeout)
                page.wait_for_load_state("domcontentloaded")

                print(f"[*] Navigating to search interface for cause number: {self.cause_no}")
                
                search_input_selector = "input#SearchQuery, input[name='CaseSearch.CaseNumber'], input#caseNumberInput"
                
                try:
                    page.wait_for_selector(search_input_selector, timeout=10000)
                    page.fill(search_input_selector, self.cause_no)
                    page.press(search_input_selector, "Enter")
                except PlaywrightTimeoutError:
                    print("[!] Standard selector timed out. Attempting fallback input targeting...")
                    fallback_input = page.locator("input[type='text']").first
                    fallback_input.fill(self.cause_no)
                    fallback_input.press("Enter")

                page.wait_for_load_state("networkidle", timeout=timeout)
                
                try:
                    case_link = page.locator(f"text={self.cause_no}").first
                    if case_link.is_visible():
                        case_link.click()
                        page.wait_for_load_state("networkidle", timeout=timeout)
                except Exception:
                    pass

                html_content = page.content()
                browser.close()
                print("[+] Live DOM HTML successfully captured from MyCase endpoint.")
                
        except Exception as e:
            self.blackhole_alerts.append({
                "type": "LIVE_FETCH_CONNECTION_FAILURE",
                "severity": "CRITICAL",
                "detail": f"Failed to retrieve live MyCase DOM via Playwright: {str(e)}"
            })
            print(f"[!] Error during live browser fetch: {e}")
            
        return html_content

    def parse_ccs_docket_html(self, html_content):
        """Uses BeautifulSoup to parse Odyssey CCS HTML tables, extract timestamps,
        filing titles, and flags administrative suppression markers.
        """
        if not html_content:
            return []
            
        soup = BeautifulSoup(html_content, "html.parser")

        status_banner = soup.find(class_="case-status") or soup.find(id="caseHeader") or soup.find(class_="header-status")
        if status_banner:
            banner_text = status_banner.get_text(strip=True).upper()
            if any(term in banner_text for term in ["RESTRICTED", "CONFIDENTIAL", "EXCLUDED", "SEALED"]):
                self.blackhole_alerts.append({
                    "type": "RESTRICTED_DOCKET_STATUS",
                    "severity": "HIGH",
                    "detail": f"Case banner indicates non-public or restricted status: '{banner_text}'.",
                })

        docket_table = soup.find("table", {"id": "ccsTable"}) or soup.find("table", class_="docket-table") or soup.find("table")

        if not docket_table:
            self.blackhole_alerts.append({
                "type": "MISSING_DOCKET_TABLE",
                "severity": "CRITICAL",
                "detail": "No valid CCS table found in HTML response. Possible administrative blackout or invalid selector.",
            })
            return []

        rows = docket_table.find_all("tr")[1:]
        for row in rows:
            cols = row.find_all(["td", "th"])
            if len(cols) >= 3:
                date_str = cols[0].get_text(strip=True)
                filed_by = cols[1].get_text(strip=True)
                description = cols[2].get_text(strip=True)

                link = cols[2].find("a", href=True)
                doc_url = link["href"] if link else None

                entry = {
                    "date": date_str,
                    "filed_by": filed_by,
                    "description": description,
                    "has_document_link": doc_url is not None,
                    "document_url": doc_url,
                }
                self.docket_entries.append(entry)
                self._check_entry_for_blackholes(entry)

        return self.docket_entries

    def _check_entry_for_blackholes(self, entry):
        desc_upper = entry["description"].upper()

        if "PROBABLE CAUSE" in desc_upper and not entry["has_document_link"]:
            self.blackhole_alerts.append({
                "type": "UNATTACHED_PROBABLE_CAUSE",
                "date": entry["date"],
                "severity": "HIGH",
                "detail": f"Probable cause entry recorded without viewable public document attachment: '{entry['description']}'.",
            })

        if any(kw in desc_upper for kw in ["CONFIDENTIAL ENTRY", "EXCLUDED FROM PUBLIC ACCESS", "SEALED ORDER"]):
            self.blackhole_alerts.append({
                "type": "CONFIDENTIAL_ENTRY_SEAL",
                "date": entry["date"],
                "severity": "MEDIUM",
                "detail": f"Administrative seal or public exclusion tag detected: '{entry['description']}'.",
            })

    def audit_exculpatory_omissions(self, expected_exhibits):
        parsed_text_blob = " ".join([e["description"].upper() for e in self.docket_entries])

        for exhibit in expected_exhibits:
            keyword = exhibit["keyword"].upper()
            if keyword not in parsed_text_blob:
                self.blackhole_alerts.append({
                    "type": "EXCULPATORY_EVIDENCE_BLACKHOLE",
                    "severity": "CRITICAL",
                    "exhibit_id": exhibit["id"],
                    "target_identifier": exhibit["identifier"],
                    "detail": f"Expected exculpatory exhibit '{exhibit['name']}' ({exhibit['identifier']}) missing from court CCS docket.",
                })

    def audit_timeline_gaps(self, max_gap_days=14):
        parsed_dates = []
        for entry in self.docket_entries:
            try:
                dt = datetime.strptime(entry["date"], "%m/%d/%Y")
                parsed_dates.append((dt, entry))
            except ValueError:
                continue

        parsed_dates.sort(key=lambda x: x[0])

        for i in range(1, len(parsed_dates)):
            prev_dt, prev_entry = parsed_dates[i - 1]
            curr_dt, curr_entry = parsed_dates[i]
            gap = (curr_dt - prev_dt).days

            if gap > max_gap_days:
                self.blackhole_alerts.append({
                    "type": "PROCEDURAL_TIMELINE_GAP",
                    "severity": "MEDIUM",
                    "start_date": prev_entry["date"],
                    "end_date": curr_entry["date"],
                    "gap_days": gap,
                    "detail": f"Unusual procedural gap of {gap} days between entries.",
                })

    def verify_master_dossier_submission(self, dossier_keyword="MASTER DOSSIER"):
        dossier_found = False
        for entry in self.docket_entries:
            if dossier_keyword in entry["description"].upper():
                dossier_found = True
                if not entry["has_document_link"]:
                    self.blackhole_alerts.append({
                        "type": "SUPPRESSED_MASTER_DOSSIER",
                        "severity": "HIGH",
                        "date": entry["date"],
                        "detail": "Master Dossier entry exists on CCS docket but hyperlink attachment is unlinked or suppressed.",
                    })
                break

        if not dossier_found:
            self.blackhole_alerts.append({
                "type": "MISSING_MASTER_DOSSIER",
                "severity": "CRITICAL",
                "detail": f"Master Dossier filing containing keyword '{dossier_keyword}' was not found on the CCS docket.",
            })

    def export_forensic_report_json(self, output_path="bs4_docket_audit.json"):
        report = {
            "cause_number": self.cause_no,
            "agency_reference": self.agency_ref,
            "prosecutor_number": self.prosecutor_no,
            "audit_timestamp_utc": datetime.utcnow().isoformat() + "Z",
            "total_docket_entries_parsed": len(self.docket_entries),
            "blackhole_alerts_detected": len(self.blackhole_alerts),
            "alerts": self.blackhole_alerts,
            "parsed_docket": self.docket_entries,
        }
        with open(output_path, "w") as f:
            json.dump(report, f, indent=4)
        return output_path

    def export_forensic_report_csv(self, output_path="bs4_docket_alerts.csv"):
        fieldnames = ["type", "severity", "date", "detail", "exhibit_id", "target_identifier", "gap_days"]
        with open(output_path, "w", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=fieldnames, extrasaction="ignore")
            writer.writeheader()
            for alert in self.blackhole_alerts:
                writer.writerow(alert)
        return output_path


